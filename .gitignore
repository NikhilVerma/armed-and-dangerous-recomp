# Game files, local exports, captures and reference checkouts never enter git: you bring your own copy of the game
# (README "Getting started"); everything derived from it lives in work/.
/orig/
/work/
/ref/
/install.log

# Original binaries and game data, wherever they turn up
*.exe
*.dll
*.xbe
*.big
*.jit
*.pcv
*.raw
*.cab
*.iso
*.xiso
*.gzp

# Build output
/build/
/out/
*.obj
*.lib
*.pdb
*.ilk
*.exp

# Rust: the engine's build directories (engine/target and every agent / tool build directory engine/target-*)
/engine/target/
/engine/target-*/
/engine_base/

# Engine run output: session logs (engine/play.bat), playtest output, playtest states and session recordings
/engine/logs/
/engine/playtests/*.out
/engine/playtests/*.log.jsonl
/engine/playtests/*.png
/engine/playtests/*.camera.json
/engine/playtests/states/
/engine/playtests/*.sessions/

# Generated progress pages for GitHub Pages (tools/progress.py --site); the SVGs in docs/progress/ are committed
/site/

# Archive (the DLL-injector era): generated calling-convention layer, lifter output and hook build output
/archive/src/gen/
/archive/hook/build/
and.log
and-crash.dmp

# Captures and comparison images dropped at the repository root (intro_compare.png and similar)
/*.png
/*.jpg
/*.bmp
*.log

# Ghidra
*.gpr
*.rep/
*.lock
*.lock~
!Cargo.lock

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Editors and OS
.vs/
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
